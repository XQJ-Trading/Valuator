# AUTH for service use
AUTH_KEY=x
AUTH_SECRET=y

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API Configuration
GOOGLE_API_KEY=your-google-api-here

# Perplexity API Configuration
PPLX_API_KEY=your-pplx-api-here

# Agent Configuration
AGENT_NAME=MyAgent
AGENT_VERSION=2.0.0
AGENT_CONCURRENCY=10
# (default model setting)
AGENT_MODEL=gemini-3-flash-preview

# Supported Models Configuration (comma-separated list)
SUPPORTED_MODELS=gemini-3-flash-preview

# Model Configuration
TEMPERATURE=1.0
MAX_TOKENS=30000
#TEMPERATURE=0.0
#MAX_TOKENS=65535
TOP_P=0.95
TOP_K=64

# Thinking Level 설정 (선택사항)
GEMINI_THINKING_LEVEL=low

# Tool Configuration
CODE_EXECUTION_TIMEOUT=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/ai_agent.log

# low-level Gemini LLM query log configuration
GEMINI_LOW_LEVEL_REQUEST_LOGGING=true
#GEMINI_LOW_LEVEL_REQUEST_LOGGING=false

# MongoDB Configuration (Optional - for ReAct session logging)
MONGODB_ENABLED=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_agent
MONGODB_COLLECTION=react_sessions

# OpenDart API Configuration
OPENDART_API_KEY=your-opendart-api-here

# # OpenRouter API Configuration
# OPENROUTER_API_KEY=your-openrouter-api-here
# LLM_BACKEND=openrouter
# AGENT_MODEL=openrouter/auto

# tavily API Configuration
TAVILY_API_KEY=tavily-api-key-here